</div>

<div class="vignette"></div>
<div class="grain"></div>

<script is:inline>
  (() => {
    const links = [...document.querySelectorAll('#ruler a')];
    const navs  = [...document.querySelectorAll('.topbar nav a[href^="#"]')];
    const now   = document.getElementById('tp-now');
    const secs  = links.map(a => document.getElementById(a.dataset.sec)).filter(Boolean);
    if (!secs.length) return;
    const mark = (id) => {
      links.forEach(a => a.classList.toggle('on', a.dataset.sec === id));
      navs.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + id));
      const on = links.find(a => a.dataset.sec === id);
      if (on && now) now.textContent = on.textContent.replace(/^\S+\s/, '') + ' · DISCO STYLE';
    };
    const seen = new Map();
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => seen.set(e.target.id, e.intersectionRatio));
      let best = null, top = -1;
      seen.forEach((v, k) => { if (v > top) { top = v; best = k; } });
      if (best && top > 0) mark(best);
    }, { threshold: [0, .12, .3, .6, 1], rootMargin: '-20% 0px -45% 0px' });
    secs.forEach(s => io.observe(s));
    mark('top');
  })();
</script>
